# Copy this file to .env.local and fill in your real values.
# Both come from Supabase: Connect -> Framework -> Next.js -> App Router,
# or Settings -> API. Use the anon/public key -- NEVER the service_role key
# here, this app runs in the browser.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
